{
  "name": "meowquee",
  "version": "1.1.0",
  "description": "A lightweight headless marquee engine for building pawesome scrolling content",
  "homepage": "https://github.com/BuddyWinte/meowquee",
  "bugs": {
    "url": "https://github.com/BuddyWinte/meowquee/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/BuddyWinte/meowquee.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/meowquee.mjs",
  "module": "./dist/meowquee.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/meowquee.mjs"
    },
    "./iife": "./dist/meowquee.iife.min.js",
    "./iife-unminified": "./dist/meowquee.iife.js"
  },
  "scripts": {
    "build": "rollup -c",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "lint": "oxlint .",
    "check": "bun run typecheck && bun run lint && bun run test",
    "dev": "bunx serve ."
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/bun": "latest",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "rollup": "^4.63.0",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.8.1",
    "typescript": "^6"
  }
}
